# Server-side collector only. Never prefix this with NEXT_PUBLIC_.
DART_API_KEY=

# Optional server-only AI explanation; never use NEXT_PUBLIC_ or commit real keys.
OPENAI_API_KEY=
# THESIS_AI_MODEL=gpt-5.6-terra
# THESIS_EVIDENCE_AI_MODEL=gpt-5.6-sol
# EVIDENCE_AI_MODEL=gpt-5.6-sol
# EVIDENCE_AI_CACHE_DIR=C:/path/to/private/evidence-ai-cache

# Optional KRX credentials. FinanceDataReader can use its public fallback when omitted.
KRX_ID=
KRX_PW=

# Optional local overrides; never expose these through NEXT_PUBLIC_.
# RESEARCH_STORAGE_DIR=C:/path/to/private/research
# DASHBOARD_BACKUP_DIR=D:/private/value-dashboard-backups
# RADAR_PYTHON_EXECUTABLE=C:/path/to/.venv/Scripts/python.exe
# RADAR_ENV_FILE=C:/path/to/private/.env

# Optional private mobile companion. Keep every value server-side; never prefix
# the Supabase secret or session secret with NEXT_PUBLIC_.
# DASHBOARD_MODE=mobile
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# MOBILE_ACCESS_PASSWORD=use-a-long-random-password
# MOBILE_SESSION_SECRET=use-a-different-long-random-secret
# NEXT_PUBLIC_SITE_URL=https://your-mobile-domain.example
