{
  "schema_version": "radar-rules.v1",
  "rule_version": "2026-09-02.v6",
  "common": {
    "market_cap_min_krw": 50000000000,
    "median_traded_value_days": 20,
    "median_traded_value_min_krw": 500000000,
    "price_history_min_days": 120,
    "event_price_history_min_days": 60,
    "price_max_age_days": 7,
    "financial_max_age_days": 180,
    "exclude_name_contains": ["스팩", "SPAC", "리츠"],
    "exclude_preferred_shares": true
  },
  "quality": {
    "minimum_evidence": 6,
    "strong_evidence": 7,
    "minimum_core_evidence": 3,
    "minimum_coverage_pct": 85,
    "profitable_quarters_required": 4,
    "profitable_quarters_window": 4,
    "cash_conversion_min": 1.3,
    "roe_min_pct": 18,
    "interest_coverage_min": 8,
    "debt_ratio_max_pct": 60,
    "operating_margin_min_pct": 12
  },
  "improvement": {
    "minimum_evidence": 4,
    "strong_evidence": 6,
    "minimum_business_evidence": 3,
    "minimum_financial_support_evidence": 1,
    "current_operating_margin_min_pct": 5,
    "minimum_coverage_pct": 65,
    "revenue_yoy_min_pct": 25,
    "operating_profit_yoy_min_pct": 50,
    "loss_narrowing_min_pct": 60,
    "margin_yoy_min_pp": 5,
    "debt_ratio_improvement_min_pp": 30
  },
  "dislocation": {
    "minimum_evidence": 5,
    "strong_evidence": 5,
    "minimum_coverage_pct": 90,
    "drawdown_52w_max_pct": -35,
    "extreme_drawdown_52w_max_pct": -50,
    "relative_return_6m_max_pp": -30,
    "price_position_120d_max_pct": 15,
    "valuation_percentile_max_pct": 10
  },
  "event": {
    "lookback_days": 120,
    "recent_event_days": 14,
    "risk_event_days": 3,
    "attention_event_days": 3,
    "strong_evidence": 2,
    "material_importance_hints": ["positive_contract", "buyback", "dilution_risk"],
    "risk_importance_hints": ["dilution_risk"],
    "attention_traded_value_multiple": 6.0,
    "attention_traded_value_min_krw": 50000000000
  }
