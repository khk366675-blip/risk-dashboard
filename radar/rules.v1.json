    "minimum_core_evidence": 3,
    "minimum_coverage_pct": 85,
    "profitable_quarters_required": 4,
    "profitable_quarters_window": 4,
    "cash_conversion_min": 1.5,
    "roe_min_pct": 20,
    "interest_coverage_min": 10,
    "debt_ratio_max_pct": 50,
    "operating_margin_min_pct": 15
  },
  "improvement": {
    "minimum_evidence": 4,
    "strong_evidence": 6,
    "minimum_business_evidence": 3,
    "minimum_financial_support_evidence": 1,
    "current_operating_margin_min_pct": 7,
    "minimum_coverage_pct": 67,
    "revenue_yoy_min_pct": 30,
    "operating_profit_yoy_min_pct": 75,
    "loss_narrowing_min_pct": 70,
